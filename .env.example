DATABASE_URL=postgresql://postgres:1234@localhost:5432/rag
VALKEY_URL=redis://127.0.0.1:6379/0
HF_TOKEN=
OPENAI_BASE_URL=https://router.huggingface.co/v1
OPENAI_MODEL=Qwen/Qwen3.5-9B
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.5
LLM_TOP_P=0.8
LLM_PRESENCE_PENALTY=0.5
LLM_TOP_K=20
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CACHE_TTL_SECONDS=3600
MAX_SIBLINGS=2
MAX_CHILDREN=8
MAX_TABLES=6
CONTEXT_CHAR_BUDGET=12000

# Phoenix (Arize) configuration for observability
PHOENIX_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=rag-evaluation

# Temporal configuration for durable workflow execution
TEMPORAL_HOST=localhost
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=rag-task-queue

# Garage (S3-compatible storage) configuration for image storage
GARAGE_ENDPOINT=http://localhost:3900
GARAGE_ACCESS_KEY=garage-key
GARAGE_SECRET_KEY=garage-secret
GARAGE_SECURE=false
GARAGE_BUCKET=rag-documents
GARAGE_REGION=garage
